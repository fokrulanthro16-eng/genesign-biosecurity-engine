# ==============================================================================
# GeneSign Biosecurity Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit .env containing live credentials to version control.

# ------------------------------------------------------------------------------
# 1. Server Runtime Configuration
# ------------------------------------------------------------------------------
PORT=8095
HOST=127.0.0.1
ENVIRONMENT=production
DEBUG=false
WORKER_CONCURRENCY=4
MAX_BATCH_RECORDS=500

# ------------------------------------------------------------------------------
# 2. NVIDIA Nemotron AI Threat Intelligence & Biosecurity Copilot
# ------------------------------------------------------------------------------
# Active LLM Provider: 'openrouter' (default cloud) or 'nvidia' (NVIDIA NIM on-prem)
ACTIVE_PROVIDER=openrouter

# OpenRouter Configuration (Primary Endpoint)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# NVIDIA NIM / Cloud Inference Configuration (Direct NIM Endpoint)
NVIDIA_API_KEY=your_nvidia_build_or_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct

# ------------------------------------------------------------------------------
# 3. Cryptographic Security & Multi-Tenant KMS Authority
# ------------------------------------------------------------------------------
# 256-bit cryptographically secure secret for JWT Bearer token generation
GENESIGN_JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Master seed for deterministic derivation of provider Ed25519 root authority
ED25519_ROOT_SEED=replace_with_32_byte_hex_seed_for_ed25519_master_key

# Directory paths for KMS private/public key storage and SQLite ledger
KMS_ROOT=keys
LEDGER_PATH=storage/ledger.db

# ------------------------------------------------------------------------------
# 4. Commercial Billing & Stripe Integration (Mock / Live)
# ------------------------------------------------------------------------------
# Set to mock_* for local sandboxing, or sk_live_... / pk_live_... for live Stripe
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# ------------------------------------------------------------------------------
# 5. Regulatory Compliance & Biosecurity Standards
# ------------------------------------------------------------------------------
DEFAULT_TENANT_ID=TWIST
REGULATORY_FRAMEWORK=US-HHS-2026;ISO-TC-276
REPORTLAB_PDF_FONT=Helvetica
