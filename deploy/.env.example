# ==============================================================================
# GeneSign Enterprise Production Environment Configuration Template
# ==============================================================================
# Copy to .env in your deployment environment and configure appropriate values.

# ------------------------------------------------------------------------------
# 1. Server Runtime Configuration
# ------------------------------------------------------------------------------
PORT=8095
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false
WORKER_CONCURRENCY=4
MAX_BATCH_RECORDS=1000

# ------------------------------------------------------------------------------
# 2. NVIDIA Nemotron AI Threat Intelligence & Biosecurity Copilot
# ------------------------------------------------------------------------------
ACTIVE_PROVIDER=openrouter
OPENROUTER_API_KEY=replace_with_production_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

NVIDIA_API_KEY=replace_with_nvidia_nim_production_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct

# ------------------------------------------------------------------------------
# 3. Cryptographic Security & Multi-Tenant KMS Authority
# ------------------------------------------------------------------------------
GENESIGN_JWT_SECRET=replace_with_64_character_cryptographically_secure_random_string
ED25519_ROOT_SEED=replace_with_32_byte_hex_seed_for_ed25519_root_authority
KMS_ROOT=/app/keys
LEDGER_PATH=/app/storage/ledger.db

# ------------------------------------------------------------------------------
# 4. Stripe Live & Webhook Integration
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_replace_with_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_signing_secret

# ------------------------------------------------------------------------------
# 5. Regulatory Compliance & Biosecurity Standards
# ------------------------------------------------------------------------------
DEFAULT_TENANT_ID=TWIST
REGULATORY_FRAMEWORK=US-HHS-2026;ISO-TC-276
REPORTLAB_PDF_FONT=Helvetica
